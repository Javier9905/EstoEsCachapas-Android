<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding"><TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TitleText" android:text="Confirma tu pedido" /><TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BodyText" android:text="" /><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Input" android:hint="@string/name" ><com.google.android.material.textfield.TextInputEditText android:id="@+id/contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:minHeight="56dp"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Input" android:hint="@string/phone" ><com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:minHeight="56dp"/></com.google.android.material.textfield.TextInputLayout><Spinner android:id="@+id/deliveryMode" android:layout_width="match_parent" android:layout_height="56dp"/><TextView android:id="@+id/deliveryInfo" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BodyText" android:text="Recogida sin costo. Para domicilio, el negocio debe confirmar cobertura y tarifa antes del pago." /><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Input" android:hint="@string/address" ><com.google.android.material.textfield.TextInputEditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:minHeight="56dp"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Input" android:hint="@string/note" ><com.google.android.material.textfield.TextInputEditText android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minHeight="56dp"/></com.google.android.material.textfield.TextInputLayout><TextView android:id="@+id/paymentLabel" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TitleText" android:text="Pasarela de pagos de demostración" android:textSize="22sp"/><TextView android:id="@+id/paymentInfo" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BodyText" android:text="No se hacen cobros ni se solicitan datos bancarios. El resultado elegido sirve para validar las pantallas." /><Spinner android:id="@+id/paymentResult" android:layout_width="match_parent" android:layout_height="56dp"/><CheckBox android:id="@+id/terms" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Confirmo el pedido y el pago simulado"/><com.google.android.material.button.MaterialButton android:id="@+id/pay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirmar pago de prueba"/><com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volver al carrito"/></LinearLay