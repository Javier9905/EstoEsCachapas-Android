rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Solo un backend con Firebase Admin SDK puede establecer custom claims.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }
    function isSeller() {
      return signedIn() && request.auth.token.role == 'seller';
    }
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      // No permitir que un cliente se asigne roles o escale privilegios.
      allow write: if false;
    }
    match /products/{productId} {
      allow read: if resource.data.active == true ||
        (signedIn() && (isAdmin() ||
          (isSeller() && resource.data.sellerId == request.auth.uid)));
      allow create: if isAdmin() || (isSeller() &&
        request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() || (isSeller() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId);
      allow delete: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
    }
    match /carts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /orders/{orderId} {
      allow read: if signedIn() &&
        (isAdmin() || resource.data.buyerId == request.auth.uid ||
          (isSeller() && resource.data.sellerId == request.auth.uid));
      // El backend debe validar precio, inventario y confirmación del pago.
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
